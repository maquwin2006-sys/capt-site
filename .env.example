# На Vercel эти значения задаются в Settings → Environment Variables (файл .env там не нужен).
PORT=3000
# MySQL игрового сервера: IP вашего VPS и отдельный пользователь для сайта (см. VERCEL.md)
DB_HOST=IP_вашего_VPS
DB_PORT=3306
DB_USER=capt_site
DB_PASS=пароль_пользователя_capt_site
DB_NAME=capt
# 1 — шифровать подключение к MySQL (обязательно, если база открыта в интернет)
DB_SSL=1
SESSION_SECRET=длинная_случайная_строка_минимум_16_символов
# Появляется сам, когда к проекту на Vercel подключено хранилище Blob
BLOB_READ_WRITE_TOKEN=
MAX_FILE_MB=25
MAX_TRACKS=20
MAX_TOTAL_MB=300
